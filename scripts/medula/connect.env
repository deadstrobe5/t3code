# Public T3 Connect build config (relay URL, Clerk publishable key, CLI OAuth
# client id, JWT template). Upstream release CI takes these from repository
# variables that a fork does not have; without them the server never starts the
# relay tunnel and the clients cannot sign in. They ship in every official
# client bundle, so they are not secrets. scripts/lib/public-config.ts maps each
# T3CODE_* value to the VITE_* name the web client reads. Values already in the
# environment win. Relay tracing is left out on purpose.
# Sourced by build.sh and build-desktop-mac.sh.
: "${T3CODE_RELAY_URL:=https://relay.t3.codes}"
: "${T3CODE_CLERK_PUBLISHABLE_KEY:=pk_live_Y2xlcmsudDMuY29kZXMk}"
: "${T3CODE_CLERK_CLI_OAUTH_CLIENT_ID:=hzxSgY2cH10sDU2r}"
: "${T3CODE_CLERK_JWT_TEMPLATE:=t3-relay}"
export T3CODE_RELAY_URL T3CODE_CLERK_PUBLISHABLE_KEY T3CODE_CLERK_CLI_OAUTH_CLIENT_ID T3CODE_CLERK_JWT_TEMPLATE
